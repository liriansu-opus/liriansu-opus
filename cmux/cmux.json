{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // This file is managed in ~/.lki/cmux/cmux.json and symlinked to
  // ~/.config/cmux/cmux.json (wired into `lki install`).
  // Terminal behavior (font / theme / transparency / keybinds) lives in the
  // Ghostty config (~/.config/ghostty/config) — cmux inherits it; don't duplicate here.
  // After editing, run `cmux reload-config` (or press Cmd+Shift+,) — no restart needed.
  // Full option list: open the $schema URL above.

  // Notification sound: rooster crow on agent notifications (native cmux,
  // replaces the old afplay Claude hook). Was muted ("none") as a stopgap while
  // every turn-complete crowed; re-enabled now that per-category gating below
  // makes a crow mean "something I need to do".
  "notifications": {
    "sound": "custom_file",
    "customSoundFilePath": "/Users/lirian/.claude/sounds/rooster.mp3",
    "unreadPaneRing": true,
    "paneFlash": true,
    "dockBadge": true,
    "showInMenuBar": true,
    // A crow = something I need to do (cmux 0.64.18+ gates agent notifications
    // per category):
    // - needs-permission: agent blocked waiting for authorization → always ring;
    // - turn-complete "whenIdle": turn ended but background subagents/scheduled
    //   wakeups still running → silent; ring once when work truly drains
    //   (pending state reads background_tasks/session_crons from the Claude
    //   Stop payload; needs Claude Code >= 2.1.x);
    // - idle-reminder: ring only when truly idle waiting for input ~60s after
    //   a turn ends; suppressed while background work is pending.
    // All three are the defaults, written out to pin the semantics; whenIdle
    // kills the "reports done right after dispatching subagents" false alarm.
    "agentPermissionPrompt": true,
    "agentTurnComplete": "whenIdle",
    "agentIdleReminder": true,
    // Per-session sound de-dupe (~/.lki/cmux/hooks/dedupe-sound.py): a session
    // crows at most ONCE until dealt with. Three mechanisms, OR'd:
    //   0. actively-viewing — cmux frontmost + that pane focused → silent
    //      (cmux never suppresses sound for the focused pane natively: cmux#942);
    //   1. rolling window — re-fires within CMUX_SOUND_DEDUPE_WINDOW (20s) stay
    //      silent, re-arms after a full quiet window;
    //   2. reset-on-view — a still-unread prior alert (cmux list-notifications)
    //      means "not looked at yet" → silent; focusing the workspace clears
    //      unread and re-arms the next crow.
    // Category gating above picks WHICH events deserve a crow; this hook keeps
    // it to ONE crow per session per attention episode. Only sound is
    // suppressed — visuals (pane ring / sidebar / badge) stay. Fail-open.
    "hooks": [
      {
        "id": "dedupe-sound-per-session",
        "command": "/usr/bin/python3 /Users/lirian/.lki/cmux/hooks/dedupe-sound.py",
        "timeoutSeconds": 5
      }
    ]
  },

  // Links: keep Cmd-clicked terminal links inside cmux's embedded browser.
  // interceptTerminalOpenCommand... still leaves shell `open <url>` to the OS
  // default browser.
  "browser": {
    "openTerminalLinksInCmuxBrowser": true,
    "interceptTerminalOpenCommandInCmuxBrowser": false
  },

  // Sidebar: collapse the working-directory path to just the last folder name
  // (e.g. "my-project" instead of "code/src/github.com/my-org/...") —
  // the sidebar is narrow.
  "sidebar": {
    "pathLastSegmentOnly": true
  }

  /* Recommended for a parallel-agent workflow — merge these keys into the
     object above (mind the commas) to enable:

  "terminal": {
    "autoResumeAgentSessions": true,
    "agentHibernation": { "enabled": true, "idleSeconds": 1800, "maxLiveTerminals": 12 }
  },
  "app": {
    "newWorkspacePlacement": "afterCurrent",
    "forkConversationDefaultDestination": "right",
    "reorderOnNotification": true
  },
  "workspaceColors": { "indicatorStyle": "leftRail" },
  "sidebar": {
    "showBranchDirectory": true,
    "showPullRequests": true,
    "showPorts": true,
    "watchGitStatus": true
  }
  */
}
