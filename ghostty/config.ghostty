# cmux's terminal-appearance config. cmux embeds libghostty and reads this
# from ~/.config/ghostty/config (hardcoded path) for font / theme / keybinds —
# cmux has no native terminal-font keys of its own. This is NOT config for a
# standalone ghostty app, so don't delete it just because ghostty isn't used.
copy-on-select = clipboard
font-family = Cascadia Code NF
# CJK: pin ALL Han/kana/CJK-punct/fullwidth codepoints to one face. Without
# this, libghostty resolves fallback per glyph via CoreText (non-deterministic,
# cached — ghostty#12173/#9410) and cmux may auto-inject its own CJK map
# (cmux#4519), so some hanzi land on a different face/weight → mixed thick/thin.
font-family = PingFang SC
font-codepoint-map = U+4E00-U+9FFF,U+3400-U+4DBF,U+3000-U+303F,U+FF00-U+FFEF,U+3040-U+30FF=PingFang SC
font-size = 15
font-style = Light
macos-option-as-alt = true
term = xterm-256color
